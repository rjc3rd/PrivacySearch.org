# Force HTTPS. The "force SSL" setting this was assumed to already be
# handled by turned out to only ever have existed on an abandoned old
# HestiaCP config for this server, not the current ISPConfig one -- plain
# HTTP was serving real content directly (confirmed via curl), which is
# also part of why Google Search Console flagged "Page with redirect".
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Security headers.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Don't let Apache list directory contents if an index file is ever missing.
Options -Indexes

# Block direct HTTP access to dotfiles (.deploy-version, etc.) -- PHP can
# still read them locally, this only blocks requests made over the web.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
